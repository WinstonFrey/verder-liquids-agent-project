# Copy to .env and fill in. Never commit .env.

# Primary LLM (OpenAI SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Fallback if OpenAI is unreachable (same SDK, different base URL)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-terra

# GPT-5.6 Terra rejects sampler params. Leave none unless you switch back to 4o.
LLM_TEMPERATURE=none

# Estimated USD for the harness summary. gpt-5.6-terra list price (short context).
LLM_INPUT_USD_PER_1M=2.0
LLM_OUTPUT_USD_PER_1M=12.0

# Observability. Kill switch: set false and nothing else changes.
# Tracing must fail silent; it must never crash a run.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Verder
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
